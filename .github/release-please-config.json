{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "initial-version": "0.1.0",
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore: release v${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "component": "ssh_bootstrap",
      "extra-files": [
        {
          "type": "yaml",
          "path": "galaxy.yml",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
